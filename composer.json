{
    "name": "semae/scriptcase-oracle",
    "description": "Consultas Oracle com binds usando a conexão ADOdb do Scriptcase.",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Semae\\ScriptcaseOracle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semae\\ScriptcaseOracle\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php tools/lint.php",
        "check-psr4": "@composer dump-autoload --optimize --strict-psr",
        "package:build": "@php tools/package/build.php",
        "package:verify": "@php tools/package/verify.php"
    }
}
